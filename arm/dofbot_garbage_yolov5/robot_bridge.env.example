# 复制成 robot_bridge.env 后填自己的值（robot_bridge.env 已被 .gitignore 忽略）
# 用法见 arm/README.md

# 跑 Flask 的那台电脑的 IP 和端口
export ROBOT_BRIDGE_URL="http://<电脑IP>:5000"

# 必须和 Flask 端 .env 里的 ROBOT_BRIDGE_TOKEN 完全一致
export ROBOT_BRIDGE_TOKEN="<替换为随机长令牌>"

# 板子自己的 IP（只用于显示）
export ROBOT_BRIDGE_DEVICE_IP="<板子IP>"

# 在电脑Flask联调模式中使用独立视频源；电脑FFmpeg编码H.264，不占设备编码资源
export ROBOT_BRIDGE_LOCAL="0"
export ROBOT_VIDEO_MODE="webrtc"
export ROBOT_VIDEO_PORT="5001"
export ROBOT_VIDEO_FPS="15"
# 改回 jpeg 可恢复 POST /api/robot/frame 上传；前端也须切到JPEG兼容模式

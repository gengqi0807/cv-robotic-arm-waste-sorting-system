# 复制成 .env 后填自己的值（.env 已被 .gitignore 忽略）

# 对外 Web 入口。0.0.0.0 允许同一局域网内的设备连接。
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 分开运行时，API 默认监听本机。前端转发 /api 请求。
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5001
# 后端部署到另一台机器时，填写其地址。默认使用本机和 BACKEND_PORT。
# BACKEND_URL=http://127.0.0.1:5001

# 板子与 Flask 之间的鉴权令牌，两边必须一致
# 生成方法：python -c "import secrets;print(secrets.token_hex(32))"
ROBOT_BRIDGE_TOKEN=<替换为随机长令牌>

# 板子的 IP（只用于展示）
ROBOT_BRIDGE_DEVICE_IP=<板子IP>

# 三角色 Web 门禁。建库和创建班组长账号后设为 1。
WEB_AUTH_REQUIRED=0
# 通过 HTTPS 部署时设为 1。
WEB_SECURE_COOKIE=0
# 本地人脸图片匹配（没有活体检测）与外部身份终端按需启用。
FACE_IMAGE_LOGIN_ENABLED=0
# SFace 余弦距离阈值，使用本地校准结果。
FACE_THRESHOLD=
FACE_TERMINAL_TOKEN=

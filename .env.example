# 复制成 .env 后填自己的值（.env 已被 .gitignore 忽略）

# Flask 监听地址：0.0.0.0 表示同一局域网内其他设备也能访问
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 板子与 Flask 之间的鉴权令牌，两边必须一致
# 生成方法：python -c "import secrets;print(secrets.token_hex(32))"
ROBOT_BRIDGE_TOKEN=<替换为随机长令牌>

# 板子的 IP（只用于展示）
ROBOT_BRIDGE_DEVICE_IP=<板子IP>

# 默认WebRTC；jpeg恢复原JPEG上传/轮询通道
VIDEO_TRANSPORT=webrtc
VIDEO_STREAM_PATH=robot-camera
# 留空时浏览器使用当前网页主机的8889端口（支持本机/局域网访问）
VIDEO_WEBRTC_BASE_URL=
# start_video.py 默认自动定位 D:/tool 中唯一可执行文件；多版本时设置完整路径
# MEDIAMTX_EXE=D:/tool/mediamtx/mediamtx_v1.19.2_windows_amd64/mediamtx.exe
# FFMPEG_EXE=D:/tool/ffmpeg/ffmpeg-master-latest-win64-gpl-shared/bin/ffmpeg.exe
